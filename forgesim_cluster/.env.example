# ==============================================================================
# .env.example — MTG Forge 4-AI Pod Simulation Cluster (forgesim.chayde.lab)
# ==============================================================================
PORT=8080

# Number of Pre-Warmed JVM Workers kept hot in RAM (Default: 10 on pve06 = ~12-15 GB RAM)
# Increase to 16 or 20 on pve06 to run 20-game batches in a single simultaneous wave!
WORKERS=10
WORKER_HEAP_MB=1536

# GitHub Self-Update Configuration (Hot-Update + Watchtower)
GITHUB_OWNER=chayde
GITHUB_REPO=mtg-deck-collection
GITHUB_BRANCH=master
GITHUB_REPO_IMAGE=forgesim
GITHUB_PAT=

# Watchtower Container Auto-Update API Token (Matches rsltool convention)
WATCHTOWER_HTTP_API_TOKEN=watchtower-secret-token-123
